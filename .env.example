# Run npm run setup:local to generate unique local credentials.
DISCOVERY_ORIGIN=http://127.0.0.1:3000
DISCOVERY_PORTAL=true
DISCOVERY_LOCAL_STORAGE=true
DISCOVERY_SECURE_COOKIE=false
DISCOVERY_ADMIN_KEY=GENERATE_WITH_NPM_RUN_SETUP_LOCAL
DISCOVERY_SESSION_SECRET=GENERATE_WITH_NPM_RUN_SETUP_LOCAL
# Azure deployment configures Cosmos with managed identity, never a browser key.
DISCOVERY_COSMOS_ENDPOINT=
