  "components": {
    "securitySchemes": {
      "adminCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wise_discovery_admin",
        "description": "Obtido emPOST/session. HttpOnly/SameSiteStrict/path/api/discovery;Secureemprodução. Nunca publicar código de acesso."
      },
      "orderKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-order-key",
        "description": "Chave privada gerada no cliente; somentehash persistido."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Item": {
        "type": "object",
        "required": [
          "id",
          "name",
          "quantity",
          "unitPrice"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "unitPrice": {
            "type": "integer",
            "description": "Centavos, definido pelo servidor"
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "number",
          "location",
          "items",
          "total",
          "status",
          "createdAt",
          "updatedAt",
          "history",
          "demo"
        ],
        "properties": {
          "number": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "total": {
            "type": "integer",
            "description": "Centavos"
          },
          "status": {
            "type": "string",
            "enum": [
              "recebido",
              "em preparo",
              "pronto",
              "entregue",
              "cancelado"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "demo": {
            "type": "boolean"
          }
        }
      },
      "CreateOrder": {
        "type": "object",
        "required": [
          "requestId",
          "key",
          "location",
          "items"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          },
          "location": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "id",
                "quantity"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "coco",
                    "agua",
                    "suco",
                    "refri",
                    "pastel",
                    "batata",
                    "peixe",
                    "milho"
                  ]
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                }
              }
            }
          }
        }
      },
      "Generic": {
        "type": "object",
        "additionalProperties": true
      },
      "Answers": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "maxLength": 6000
        },
        "description": "P01…P13; questionários1.0 possuem10perguntas/limite2000."
      },
      "StudioChange": {
        "type": "object",
        "required": [
          "etag",
          "stage",
          "content",
          "reviewed"
        ],
        "properties": {
          "etag": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "business",
              "prd",
              "pss",
              "blueprint",
              "requirements",
              "kernel",
              "design",
              "architecture",
              "ml",
              "validation",
              "deployment"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 10,
            "maxLength": 12000
          },
          "reviewed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
